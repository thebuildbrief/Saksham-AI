# Development only; enter production values in Vercel Environment Variables.
APP_ENV=development
DEBUG=false
APP_SECRET_KEY=
JWT_SECRET_KEY=
FRONTEND_ORIGINS=http://localhost:5173
DATABASE_URL=sqlite:///./saksham.db
DATABASE_POOL_SIZE=1
REDIS_URL=

# Use openai, gemini, groq, anthropic, or mock (development only).
AI_PROVIDER=mock
AI_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
AI_REQUEST_TIMEOUT_SECONDS=20

# Isolated execution provider; production Judge0 URLs must use HTTPS.
JUDGE0_API_URL=
JUDGE0_API_KEY=
CODE_CPU_TIME_LIMIT=2
CODE_WALL_TIME_LIMIT=5
CODE_MEMORY_LIMIT_KB=256000
CODE_PROVIDER_TIMEOUT_SECONDS=12
CODE_REQUEST_TIMEOUT_SECONDS=30
CODE_MAX_CONCURRENT=4
CODE_MAX_TEST_CASES=20

# Use s3 in production. Local storage is development-only and ephemeral on Vercel.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage/uploads
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ENDPOINT_URL=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
MAX_RESUME_SIZE_BYTES=3145728

VOICE_PROVIDER=browser
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
SUBSCRIPTION_PROVIDER=none
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
